    "moduleNameMapper": {
      "^test-renderer$": "<rootDir>/node_modules/react-test-renderer/index.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|zustand|axios|@testing-library)"
    ]
  },
  "private": true
