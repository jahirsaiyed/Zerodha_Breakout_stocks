# =============================================================================
# Trading Portfolio Management System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=trading
DB_USERNAME=trading
# Strong password required in production
DB_PASSWORD=changeme_in_production

# -----------------------------------------------------------------------------
# Spring Boot datasource (used directly by the backend service)
# Set automatically by docker-compose.yml when services communicate internally;
# override here only when running the backend outside Docker.
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/trading

# -----------------------------------------------------------------------------
# Security — JWT
# Minimum 64 characters. Generate with: openssl rand -hex 64
# -----------------------------------------------------------------------------
JWT_SECRET=changeme_replace_with_64_char_minimum_random_hex_string_here_000000

# JWT token expiry in milliseconds (86400000 = 24 hours)
JWT_EXPIRY_MS=86400000

# -----------------------------------------------------------------------------
# Security — Encryption key for sensitive fields stored in the database
# Minimum 32 characters. Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=changeme_replace_with_32_char_minimum_random_string_here

# -----------------------------------------------------------------------------
# Zerodha Kite Connect API
# Obtain from https://developers.kite.trade/
# -----------------------------------------------------------------------------
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Spring active profile: local | dev | prod
SPRING_PROFILES_ACTIVE=dev

# Server port (inside the container; mapped to host via docker-compose.yml)
SERVER_PORT=8080

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_TRADING=DEBUG
