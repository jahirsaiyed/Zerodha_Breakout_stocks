# ============================================================
# Trading Portfolio System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_NAME=trading
DB_USERNAME=trading
# Strong password required in production
DB_PASSWORD=changeme_in_production

# Override only when running backend outside Docker
DB_URL=jdbc:postgresql://localhost:5432/trading

# ── Security ─────────────────────────────────────────────────
# Minimum 64 characters. Generate with: openssl rand -hex 64
JWT_SECRET=changeme_replace_with_64_char_minimum_random_hex_string_here_000000

# Minimum 32 characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=changeme_replace_with_32_char_minimum_random_string_here

# ── Cookie settings ──────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend URL (used by backend OAuth callback redirect) ───
# In production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ── Zerodha Kite Connect ─────────────────────────────────────
# Create one developer app at https://developers.kite.trade/
# All users authenticate through this shared app via OAuth.
# Each user still gets their own access_token scoped to their Zerodha account.
ZERODHA_API_KEY=your_kite_connect_api_key
ZERODHA_API_SECRET=your_kite_connect_api_secret
ZERODHA_BASE_URL=https://api.kite.trade
ZERODHA_LOGIN_BASE_URL=https://kite.zerodha.com/connect/login?v=3&api_key=
ZERODHA_CONNECT_TIMEOUT_MS=10000
ZERODHA_READ_TIMEOUT_MS=30000
# Override the base URL for order placement (used for IP-whitelisting proxy)
# Leave blank to use ZERODHA_BASE_URL for all requests
ZERODHA_ORDER_BASE_URL=

# ── Google Sheets ────────────────────────────────────────────
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
# Absolute path to service account credentials JSON file
SHEETS_CREDENTIALS_PATH=
# Cell range to read — use single-quoted sheet name if it contains spaces
# Columns read: B=Symbol, K=Entry, L=StopLoss, M=Target, Q=Comments
SHEETS_RANGE='NSE Stock break out Ideas'!A2:Q

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BASE_URL=https://api.telegram.org

# ── Signal scoring weights (must sum to 1.0) ─────────────────
SCORING_PROXIMITY_WEIGHT=0.6
SCORING_RISK_REWARD_WEIGHT=0.4

# ── Production only ──────────────────────────────────────────
# Your server's domain name (used in Nginx SSL config)
# DOMAIN=trading.yourdomain.com

# ── Render + Vercel deployment (GitHub Actions secrets) ───────
# Set these in: GitHub repo → Settings → Secrets and variables → Actions
#
# RENDER_DEPLOY_HOOK_URL   Render dashboard → Service → Settings → Deploy Hook
# VERCEL_TOKEN             vercel.com → Account Settings → Tokens → Create
# VERCEL_ORG_ID            vercel.com → Project Settings → General (Team ID)
# VERCEL_PROJECT_ID        vercel.com → Project Settings → General (Project ID)
#
# After first Render deploy, also update vercel.json:
#   Replace "https://trading-backend.onrender.com" with your actual Render URL
#   (it's https://<service-name>.onrender.com if you kept the name "trading-backend")
